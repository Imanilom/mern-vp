# ─── MongoDB ──────────────────────────────────────────────────────────────────
# Untuk Docker: mongodb://MONGO_USER:MONGO_PASSWORD@mongodb:27017/healthdevice?authSource=admin
# Untuk Atlas : mongodb+srv://<user>:<pass>@cluster.mongodb.net/?retryWrites=true&w=majority
MONGO=

MONGO_INITDB_ROOT_USERNAME=
MONGO_INITDB_ROOT_PASSWORD=

# ─── App ──────────────────────────────────────────────────────────────────────
PORT=3030
NODE_ENV=production

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Gunakan string acak yang kuat, minimal 32 karakter
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Origin yang diizinkan, pisahkan dengan koma jika lebih dari satu
# Contoh: https://yourdomain.com,http://localhost:3031
ALLOWED_ORIGINS=

# ─── Internal Pipeline Key ────────────────────────────────────────────────────
# Kunci untuk endpoint /api/internal/run-pipeline (dipanggil systemd timer)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_KEY=

# ─── RabbitMQ ─────────────────────────────────────────────────────────────────
RABBITMQ_URI=
QUEUE_NAME=Sensor

# ─── Garmin / OAuth ───────────────────────────────────────────────────────────
CLIENT_ID=
CLIENT_SECRET=
UAT=
UAT_SECRET=
NONCE=
UserAccessToken=
UserId=

# ─── FTP ──────────────────────────────────────────────────────────────────────
FTP_HOST=
FTP_USER=
FTP_PASSWORD=
FTP_SECURE=false
FTP_PORT=21

# ─── Migration (opsional, hanya untuk migrate-db.js) ──────────────────────────
SOURCE_MONGO_URI=
TARGET_MONGO_URI=
