# ─── MongoDB ──────────────────────────────────────────────────────────────────
# Untuk Docker: mongodb://MONGO_USER:MONGO_PASSWORD@mongodb:27017/healthdevice?authSource=admin
# Untuk Atlas : mongodb+srv://<user>:<pass>@cluster.mongodb.net/?retryWrites=true&w=majority
# Compose MongoDB URI with the initialized root user and password.
# URL-encode password characters that have a special meaning in URIs.
# For the VPS MongoDB container, use host `mongodb`, the existing credentials,
# and the database already containing the application data.
MONGO=

MONGO_INITDB_ROOT_USERNAME=
MONGO_INITDB_ROOT_PASSWORD=

# ─── App ──────────────────────────────────────────────────────────────────────
PORT=3030
NODE_ENV=production

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Gunakan string acak yang kuat, minimal 32 karakter
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Origin halaman web yang diizinkan, pisahkan dengan koma jika lebih dari satu
ALLOWED_ORIGINS=https://vidyamedic.my.id,https://www.vidyamedic.my.id

# ─── Internal Pipeline Key ────────────────────────────────────────────────────
# Kunci untuk endpoint /api/internal/run-pipeline (dipanggil systemd timer)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_KEY=

# ─── Gemini personal chatbot ──────────────────────────────────────────────────
# Simpan API key hanya di environment backend; jangan masukkan ke aplikasi Flutter.
# GEMINI_API_KEY=your_gemini_api_key
# GEMINI_MODEL=gemini-2.5-flash

# ─── RabbitMQ ─────────────────────────────────────────────────────────────────
RABBITMQ_URI=
QUEUE_NAME=Sensor

# ─── Garmin / OAuth ───────────────────────────────────────────────────────────
CLIENT_ID=
CLIENT_SECRET=
UAT=
UAT_SECRET=
NONCE=
UserAccessToken=
UserId=

# ─── FTP ──────────────────────────────────────────────────────────────────────
FTP_HOST=
FTP_USER=
FTP_PASSWORD=
FTP_SECURE=false
FTP_PORT=21

# ─── Migration (opsional, hanya untuk migrate-db.js) ──────────────────────────
SOURCE_MONGO_URI=
TARGET_MONGO_URI=
